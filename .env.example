# ==============================================================================
# CARTÓRIO DO AMOR - MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para .env e preencha com as suas credenciais reais.
# Este arquivo é seguro e PODE ir para o GitHub.
# ==============================================================================

# Mercado Pago (Pagamentos Pix)
MERCADO_PAGO_ACCESS_TOKEN=seu_access_token_aqui
MERCADO_PAGO_PUBLIC_KEY=sua_public_key_aqui

# Google Gemini IA (Gerador de Votos Afetivos)
GEMINI_API_KEY=sua_chave_gemini_aqui
